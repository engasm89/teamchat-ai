{
  "name": "teamchat-ai-assessment",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=22.10"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "verify:fixtures": "node --experimental-strip-types scripts/verify-fixtures.ts",
    "seed:sql": "node --experimental-strip-types scripts/generate-seed-sql.ts",
    "test:postgres": "node --experimental-strip-types --test scripts/integration/live-postgres.test.ts",
    "provision:users": "node --experimental-strip-types scripts/provision-demo-users.ts",
    "start:api": "node --experimental-strip-types src/server/start.ts",
    "start:worker": "node --experimental-strip-types src/worker/start.ts",
    "embed:backfill": "node --experimental-strip-types scripts/backfill-memory-embeddings.ts",
    "test:postgres:required": "REQUIRE_POSTGRES=1 node --experimental-strip-types --test scripts/integration/live-postgres.test.ts",
    "verify:packaging": "node --experimental-strip-types scripts/verify-package-locks.ts",
    "verify:release": "npm run verify:packaging && npm run check && npm test && npm run verify:fixtures && npm run test:postgres:required && npm --prefix apps/web run build",
    "demo:bootstrap:live": "node --experimental-strip-types scripts/bootstrap-live-demo-history.ts",
    "verify:prelive": "npm run check && npm test && npm run verify:fixtures && npm run seed:sql"
  },
  "description": "Controlease TeamChat AI pre-live audited source; cloud integration and deployment are required release gates",
  "devDependencies": {
    "@types/node": "^22.19.0",
    "playwright": "^1.64.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@google-cloud/tasks": "^6.2.1",
    "@google/genai": "^1.30.0",
    "firebase-admin": "^13.5.0",
    "google-auth-library": "^10.3.0",
    "jose": "^6.2.12",
    "pg": "^8.16.0",
    "ws": "^8.18.3"
  }
}
